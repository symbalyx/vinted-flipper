# ╔══════════════════════════════════════════════════════════════╗
# ║  JARVIS v5.2 — Exemple de configuration (.env)                ║
# ║  Copie ce fichier en `.env` et remplis. NE COMMITE JAMAIS .env ║
# ╚══════════════════════════════════════════════════════════════╝
# Aucune valeur ici n'est un secret réel : ce sont des exemples.

# ── Serveur / auth ──────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8004
JARVIS_AUTH=1
JARVIS_PASSWORD=change-me-please           # mot de passe du dashboard
JARVIS_SECRET=                              # clé Flask (auto-générée si vide)
JARVIS_API_TOKEN=                           # jeton d'API pour scripts (auto si vide)
JARVIS_CORS_ORIGINS=                        # ex: https://mondomaine.tld (vide = aucune)

# HTTPS : soit un certificat, soit adhoc (test), soit reverse-proxy (recommandé)
JARVIS_SSL_CERT=
JARVIS_SSL_KEY=
# JARVIS_HTTPS=adhoc

# ── Backend IA ──────────────────────────────────────────────────
JARVIS_BACKEND=ollama                       # ollama | deepseek
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
DEEPSEEK_API_KEY=                           # si backend=deepseek (côté serveur)

# ── Sécurité des outils / fallback ──────────────────────────────
JARVIS_LEGACY_TAGS=0                         # 0 = tags sensibles [CMD]/[TUER]/… désactivés
JARVIS_SECURITY_AUTOSTART=0                  # 1 = démarre la caméra en mode WSGI

# ── 🛡️ MODE GARDIEN ─────────────────────────────────────────────
GUARDIAN_CLOUD_VISION=0                      # 0 = AUCUNE image ne quitte le réseau local
GUARDIAN_AUDIO_ENABLED=0                     # audio/temps réel désactivé par défaut
GUARDIAN_RETENTION_DAYS=7                    # purge auto des événements/décisions
GUARDIAN_SAVE_TRANSCRIPTS=0                  # ne pas stocker les transcriptions
GUARDIAN_AUTO_ESCALATE=0                     # sirène auto sans humain : OFF par défaut
GUARDIAN_VISION_PROVIDER=ollama             # ollama | openai | gemini
GUARDIAN_SPEECH_PROVIDER=ollama             # ollama | template
GUARDIAN_REALTIME_PROVIDER=none             # none | openai | gemini
GUARDIAN_LOITER_SECONDS=20
GUARDIAN_MIN_CONFIRMATIONS=3
GUARDIAN_SIREN_MAX_SECONDS=30
GUARDIAN_MAX_IMAGE_BYTES=2000000
GUARDIAN_RATE_LIMIT_PER_MIN=30
JARVIS_VISION_MODEL=llava                    # modèle vision local (Ollama)

# ── Fournisseurs cloud (clés CÔTÉ SERVEUR UNIQUEMENT, jamais au navigateur) ──
OPENAI_API_KEY=                             # ex: sk-... (reste sur le serveur)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=                             # Gemini Live : squelette (non finalisé)
GEMINI_VISION_MODEL=gemini-1.5-flash

# ── 🛰️ OSINT d'infrastructure (IP/domaine/hachage — jamais de personnes) ──
# Géolocalisation d'IP OPTIONNELLE et désactivée par défaut (local-first).
# Renseigne un fournisseur pour l'activer ; {ip} est remplacé par l'adresse.
OSINT_GEO_URL=                               # ex: http://ip-api.com/json/{ip}
OSINT_TIMEOUT=5

# ── Notifications / urgence ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Urgence : par DÉFAUT on contacte le PROPRIÉTAIRE, pas les secours.
EMERGENCY_CONTACT=                           # +33... (contact de confiance)
EMERGENCY_NUMBER=                            # +33... (dernier recours)
EMERGENCY_AUTO_DIAL=0                        # 0 = jamais d'appel automatique
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
