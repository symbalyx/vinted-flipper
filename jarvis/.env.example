# ╔══════════════════════════════════════════════════════════════╗
# ║  JARVIS v5.6 — Exemple de configuration (.env)                ║
# ║  Copie ce fichier en `.env` et remplis. NE COMMITE JAMAIS .env ║
# ╚══════════════════════════════════════════════════════════════╝
# Aucune valeur ici n'est un secret réel : ce sont des exemples.

# ── Serveur / auth ──────────────────────────────────────────────
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8004
JARVIS_AUTH=1
JARVIS_PASSWORD=change-me-please           # mot de passe du dashboard
JARVIS_SECRET=                              # clé Flask (auto-générée si vide)
JARVIS_API_TOKEN=                           # jeton d'API pour scripts (auto si vide)
JARVIS_CORS_ORIGINS=                        # ex: https://mondomaine.tld (vide = aucune)
JARVIS_MAX_REQUEST_BYTES=4000000              # limite globale des requêtes HTTP

# HTTPS : soit un certificat, soit adhoc (test), soit reverse-proxy (recommandé)
JARVIS_SSL_CERT=
JARVIS_SSL_KEY=
# JARVIS_HTTPS=adhoc

# ── Backend IA ──────────────────────────────────────────────────
JARVIS_BACKEND=ollama                       # ollama | deepseek
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
DEEPSEEK_API_KEY=                           # si backend=deepseek (côté serveur)

# ── Sécurité des outils / fallback ──────────────────────────────
JARVIS_LEGACY_TAGS=0                         # 0 = toutes les anciennes balises désactivées
JARVIS_APPROVAL_TTL=600                       # 60-3600 s pour approuver une action sensible
JARVIS_SECURITY_AUTOSTART=0                  # 1 = démarre la caméra en mode WSGI

# ── 🛡️ MODE GARDIEN ─────────────────────────────────────────────
GUARDIAN_CLOUD_VISION=0                      # 0 = AUCUNE image ne quitte le réseau local
GUARDIAN_AUDIO_ENABLED=0                     # audio/temps réel désactivé par défaut
GUARDIAN_RETENTION_DAYS=7                    # purge auto des événements/décisions
GUARDIAN_SAVE_TRANSCRIPTS=0                  # ne pas stocker les transcriptions
GUARDIAN_AUTO_ESCALATE=0                     # sirène auto sans humain : OFF par défaut
GUARDIAN_VISION_PROVIDER=ollama             # ollama | openai | gemini
GUARDIAN_SPEECH_PROVIDER=ollama             # ollama | template
GUARDIAN_REALTIME_PROVIDER=none             # none | openai | gemini
GUARDIAN_LOITER_SECONDS=20
GUARDIAN_MIN_CONFIRMATIONS=3
GUARDIAN_SIREN_MAX_SECONDS=30
GUARDIAN_MAX_IMAGE_BYTES=2000000
GUARDIAN_RATE_LIMIT_PER_MIN=30
GUARDIAN_PHOTO_GEO_RATE_LIMIT_PER_MIN=6       # analyses photo/minute
GUARDIAN_PHOTO_GEO_MIN_CONFIDENCE=0.35        # candidats visuels sous ce seuil rejetés
JARVIS_VISION_MODEL=llava                    # modèle vision local (Ollama)

# ── Fournisseurs cloud (clés CÔTÉ SERVEUR UNIQUEMENT, jamais au navigateur) ──
OPENAI_API_KEY=                             # ex: sk-... (reste sur le serveur)
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TOKEN_TTL=60                 # secondes, borné côté serveur
OPENAI_SAFETY_IDENTIFIER=                    # identifiant stable haché, jamais une donnée brute
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_API_KEY=                             # Gemini Live : squelette (non finalisé)
GEMINI_VISION_MODEL=gemini-1.5-flash

# ── 🛰️ OSINT d'infrastructure (IP/domaine/hachage — jamais de personnes) ──
# Géolocalisation d'IP OPTIONNELLE et désactivée par défaut (local-first).
# Renseigne un fournisseur pour l'activer ; {ip} est remplacé par l'adresse.
OSINT_GEO_URL=                               # ex: http://ip-api.com/json/{ip}
OSINT_TIMEOUT=5

# ── Notifications / urgence ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Urgence : par DÉFAUT on contacte le PROPRIÉTAIRE, pas les secours.
EMERGENCY_CONTACT=                           # +33... (contact de confiance)
EMERGENCY_NUMBER=                            # +33... (dernier recours)
EMERGENCY_AUTO_DIAL=0                        # 0 = jamais d'appel automatique
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── 🏗️ JARVIS Agency durable / missions multi-agents ─────────
JARVIS_AGENCY_DB=data/agency.db              # missions, checkpoints, reçus et mémoire
JARVIS_MAX_SUBAGENTS=4                       # 1 à 8 sous-agents simultanés
JARVIS_SUBAGENT_TURNS=24                     # 6 à 60 tours function-calling par étape
JARVIS_STEP_ATTEMPTS=4                       # retries courts avant backoff long
JARVIS_AGENCY_AUTO_RECOVER=1                 # reprend interrupted/retry_wait/paused
# max_minutes est une tranche (jusqu'à 7 jours). En mode continue_until_done,
# une nouvelle tranche est reprise automatiquement jusqu'à validation/annulation.

# ── ⚙️ Durabilité v5.7 : baux d'étape, heartbeat, reaper, backoff ──
AGENCY_MAX_CONCURRENT_AGENTS=8               # agents simultanés (borne dure)
AGENCY_DEFAULT_MAX_ATTEMPTS=5                # essais max par défaut d'une étape
AGENCY_LEASE_SECONDS=30                      # bail MISSION
AGENCY_HEARTBEAT_SECONDS=5                   # heartbeat mission
AGENCY_STEP_LEASE_SECONDS=120               # bail ÉTAPE (récupération worker mort)
AGENCY_STEP_HEARTBEAT_SECONDS=20            # heartbeat étape
AGENCY_REAPER_INTERVAL_SECONDS=30           # fréquence du reaper (étapes abandonnées)
AGENCY_RETRY_BASE_SECONDS=10                # backoff : délai de base
AGENCY_RETRY_MAX_SECONDS=3600               # backoff : plafond
AGENCY_RETRY_JITTER_RATIO=0.20              # jitter borné (± ratio)

# ── 🎯 Prospection professionnelle assistée ────────────────────
JARVIS_PROSPECTING_DB=data/prospecting.db

# Sauvegardes cohérentes SQLite pour missions et CRM
JARVIS_DURABLE_BACKUPS=1
JARVIS_BACKUP_DIR=data/backups
JARVIS_BACKUP_INTERVAL_HOURS=24
JARVIS_BACKUP_KEEP=14
PROSPECTING_MAX_SENDS_PER_DAY=10             # garde-fou, même avec approbations
PROSPECTING_MAX_SENDS_PER_DOMAIN=2
PROSPECTING_MIN_SEND_INTERVAL=120            # secondes entre deux envois
# Aucun envoi de masse automatique. Chaque brouillon est approuvé individuellement.

# n8n Public API — la clé reste côté serveur
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=
N8N_TIMEOUT=15
N8N_VERIFY_TLS=1
N8N_ALLOW_RISKY_NODES=0                     # garde Execute Command/Code/SSH refusés

# SMTP — l'envoi est toujours CRITICAL et nécessite une approbation dans JARVIS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
SMTP_SSL=0
SMTP_TIMEOUT=20

# ── 🎙️ Voix locale rapide ──────────────────────────────────────
VOICE_STT_ENABLED=1
VOICE_STT_MODEL=base                         # CPU rapide : tiny/base ; meilleure précision : small
VOICE_STT_DEVICE=cpu                         # cpu | cuda
VOICE_STT_COMPUTE_TYPE=int8                  # CPU=int8 ; GPU=float16 ou int8_float16
VOICE_LANGUAGE=fr
VOICE_BEAM_SIZE=1                            # 1 = plus rapide pour conversation
VOICE_VAD_FILTER=1
VOICE_MAX_AUDIO_BYTES=8000000
VOICE_AUTO_SEND=0                            # 1 = envoie automatiquement après transcription
